<?xml version="1.0" encoding="utf-8"?>
<!--
  Bonus / stage after installing mitmproxy CA as a SYSTEM certificate:
  do NOT trust user CAs — only the system store.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
