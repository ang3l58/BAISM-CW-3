<?xml version="1.0" encoding="utf-8"?>
<!-- Stages 1-3: system CAs only (User CA NOT trusted). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
